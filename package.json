    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "^8.0.0",
    "axios": "^1.13.2",
    "expo": "~54.0.29",
    "expo-application": "^7.0.8",
    "expo-battery": "~10.0.8",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.12",
    "expo-dev-client": "~6.0.20",
    "expo-device": "^8.0.10",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
