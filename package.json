{
  "name": "tubitak-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "simulate": "npx tsx services/simulation/runSimulation.ts",
    "sim:walk": "npx tsx services/simulation/runSimulation.ts -s walking -x 5",
    "sim:idle": "npx tsx services/simulation/runSimulation.ts -s idle",
    "sim:car": "npx tsx services/simulation/runSimulation.ts -s car",
    "sim:charge": "npx tsx services/simulation/runSimulation.ts -s charging_walk",
    "sim:charge-idle": "npx tsx services/simulation/runSimulation.ts -s charging_idle",
    "sim:run": "npx tsx services/simulation/runSimulation.ts -s running_slow -x 5",
    "sim:run-fast": "npx tsx services/simulation/runSimulation.ts -s running_fast -x 5",
    "sim:run-interval": "npx tsx services/simulation/runSimulation.ts -s running_interval -x 5",
    "sim:all": "npx tsx services/simulation/runSimulation.ts -s all"
  },
  "dependencies": {
    "@elevenlabs/react-native": "^1.0.0",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.8",
